# API du starter bulletproof-react (routes /app et /auth uniquement).
# Requise au demarrage par le schema de config/env.ts : sans elle, la page
# est blanche. Une URL syntaxiquement valide suffit tant qu'il n'y a pas
# de backend.
VITE_APP_API_URL=https://api.example.com

# TOUJOURS false en production : sinon MSW demarre et intercepte le POST
# du formulaire de contact, aucun message n'est envoye.
VITE_APP_ENABLE_API_MOCKING=false

# Endpoint Formspree du formulaire de contact.
# Vide = soumission simulee cote client, rien n'est envoye.
VITE_APP_CONTACT_ENDPOINT=https://formspree.io/f/your-form-id

# Domaine public, schema inclus. Alimente le lien du site, le partage
# et l'URL de la vCard encodee dans le QR code.
VITE_APP_SITE_URL=https://koracomsn.com
